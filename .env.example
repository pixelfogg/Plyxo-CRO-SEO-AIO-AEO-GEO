# ==============================================================================
# PLYXO COMMUNITY EDITION — ENVIRONMENT TEMPLATE
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# 1. PostgreSQL Database Connection
# Dedicated isolated database for Plyxo Community Edition
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plyxo_community
COMMUNITY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plyxo_community

# 2. Google Gemini AI API Keys (Comma-separated for multi-key load balancing)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEYS=your_gemini_api_key_here

# 3. Google PageSpeed Insights (PSI) API Key
# Get your free key at: https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PSI_API_KEY=your_google_psi_api_key_here

# 4. Browserless.io Headless Browser (For Visual Screenshots & DOM Audits)
# Get a token at: https://www.browserless.io/
BROWSERLESS_API_KEYS=your_browserless_api_key_here

# 5. Local Mock Client Defaults (Preconfigured)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
